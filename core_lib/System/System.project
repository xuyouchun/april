<?xml version="1.0" encoding="utf-8" ?>

<project>

    <name>System</name>
    <files>

        <file>
            <path>*.cs</path>
        </file>

        <file>
            <path>Runtime/*.cs</path>
        </file>

        <file>
            <path>Runtime/CompilerServices/*.cs</path>
        </file>

        <file>
            <path>Collections/*.cs</path>
        </file>

        <file>
            <path>Diagnostics/*.cs</path>
        </file>

        <file>
            <path>Linq/*.cs</path>
        </file>

        <file>
            <path>Globalization/*.cs</path>
        </file>

        <file>
            <path>Reflection/*.cs</path>
        </file>

        <file>
            <path>Text/*.cs</path>
        </file>

        <file>
            <path>Text/RegularExpressions/*.cs</path>
        </file>

        <file>
            <path>Numerics/*.cs</path>
        </file>

    </files>

    <resources>
        <resource><path>Text/gb18030.bin</path></resource>
    </resources>

</project>
