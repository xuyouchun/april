#! tools/text2cpp.py

//-------- ---------- ---------- ---------- ----------
__pattern

#----------------------------------------

# Import statement.
$import: (from from:$mname)? import import:$mname (as name)? \; ;

# Constant values.
$cvalue: cvalue | true | false | null;

# An index counted from the end (^1), and a range of the items (1..3, ..2, 1.., ^3..): the brackets of an index have it.
$index_range: (\^? $expression)? \.\. (\^? $expression)? | \^ $expression ;

# Array index or Property index.
$index:  $_single_expression ( [ | \?[ ) ($arguments | $index_range) ] ;

# Function name, Can be a real name or any expressions.
# A lambda in brackets is called at once: ((Int32 x) => x + 1)(2) .
$_function_name_expression: (
    name $generic_args? | base | this | $index | $function | $new
    | \( $lambda \)
);

# Function calling expression.
$function: $_function_name_expression \( $arguments? \) ;

# New object expression.
$new: new $type_name? (\( $arguments? \) | (\( $arguments? \))? { (($__assign: (name !:=)? $expression | { $expression (, $expression)+ }) (, $__assign)* ,?)? }) ;

# Array initializer, such as: new int[] { 1, 2, 3 } . It can be empty: new int[] { } .
$array_initializer: { (($__item: $array_initializer | $expression) (, $__item)* ,?)? } ;

# Array lengths, such as: new int[10, 20] .
$array_lengths: $expression? (, $expression? )* ;

# New array expression, such as: new int[] { 1, 2, 3 }.
$new_array: new $type_name ( [ | \?[ ) $array_lengths? ] ( [ ,* ] )* $array_initializer? ;

# Lambda expression: (Int32 a, Int32 b) => a + b , or with a body: (String s) => { ... } .
# The params have types, and the lambda uses no variable of the method that has it.
# The params of a lambda may have no types: (a, b) => a + b , x => x + 1 : the types are
# those of the delegate that the lambda is converted to.
$lambda: async? ( \( $params? \) | \( name (, name)* \) | name ) => ($method_body | $expression | throw $expression) ;

# Typeof expression: typeof(T).
$type_of: typeof \( $type_name \) ;

# Default value expression: default(T). The type can be left to the context: int a = default; , return default; (the default
# literal).
$default_value: default (\( $type_name \))? ;

# Throw expression: x ?? throw new Exception(); , a? b : throw new Exception(); . It is the right operand of ??, or a branch of
# ?: (a throw statement is not an expression).
$throw_exp: throw $expression ;

# Checked expression: checked(a + b), unchecked(a + b): the arithmetic of the expression raises
# OverflowException when the result does not fit its type, or not.
$checked_exp: (checked | unchecked) \( $expression \) ;

# Await expression: await task . The operand is a name, a call, a member, an index... (await a.F() waits for what a.F() returns;
# await a + b is (await a) + b). It is an operand of an expression, so that an index or a call after it belongs to its operand.
$await_exp: await $_single_expression ;

# With expression: s with { Number = 5 } is a copy of the struct s, and the members of it are set.
$with_exp: $_single_expression with { (($__assign: (name !:=)? $expression) (, $__assign)* ,?)? } ;

# Type name expression: System.Int32.
$type_name_exp: $type_name ;

# A name that declares a variable: out int value, o is string s.
$declaration_exp: $type_name name ;

# Type cast expression: (T)100 . Its operand ends where an index, a call or a member of it ends:
# (Double)items[k] is the cast of an item (the cast is not an item of an expression, or the index
# would be the one of the cast).
$type_cast_exp: \( $type_name \) ($_single_expression | $type_cast_exp) ;

# Simple expression.
$_single_expression: ($__item:
      name | $cvalue | base | this
    | $index | $function | $new_array | $new | $type_of
    | $default_value | $checked_exp | $name_unit | $lambda
    | \( (name `\: )? $_expression (, (name `\: )? $_expression)* \)    # a tuple, its items can have names
  ) !!? ( (. | \?.) $__item !!? )*
#|
#  $type_name_exp (. $__item )+
;

# Expression, such as a + b * c.
$_expression: 
    ($_single_expression | $type_cast_exp | $await_exp | $with_exp)
    (
        (
             \+  | -   | \*  | /   | %
          | \+=  | -=  | \*= | /=  | %=
          | =    | ==  | !=  | `>  | >= | `< | <=
          | <<   | <<= | >>  | >>=
          | &&   | \|\|
          | \|   | ^   | &   | \|= | &= | ^=
          | \?\? | \?\?=
        ) $_expression                                  # binary operator
      | \?\? $throw_exp                                 # x ?? throw e
      | \? $throw_exp `\: $_expression                  # c ? throw e : x
      | \? $_expression `\: $throw_exp                  # c ? x : throw e
      | as $type_name_exp                               # as type
      | is not? ( $declaration_exp | $type_name_exp | $cvalue ) # is type, is null, is T v
      | \? $_expression `\: $_expression                # xxx? xxx : xxx   ? :
      | (\+\+ | --)                                     # right unary operator
    )*
    | (`\+ | `- | `\+\+ | `-- | ! | ~ ) $_expression    # left unary operator
;

# Expression, such as a + b * c.
$expression:  $_expression ;

# Multipy expressions, such as (a + b, c + d).
$expressions: $expression (, $expression)* ;

# Namespace statement: namespace System.Text { ... } , or namespace System.Text; that has
# no body: the types and namespaces that follow it in the file are its members. (The ast
# factory moves them, the grammar is not ambiguous.)
$namespace:
    namespace $mname
    (
        {
            $using*
            ($namespace | $type | $type_def)*
        }
      | \;
    )
;

# Using statement: using System; , or the alias of a namespace: using Text = System.Text; . (The alias of a type is a
# typedef.)
$using: using (name =)? $mname \; ;

# Multipy name: System.Text.StringBuilder .
$mname: name ( . name ) * ;

# Decorates of type or members. volatile is accepted and ignored: one managed thread runs at a time.
$decorate: 
    (
      ($__complex: protected internal | internal protected | private protected | protected private)
      | public | private | protected | internal
      | static | sealed | abstract | readonly | const | new | abstract | override | virtual | extern
      | partial | volatile | required
    )*
;

# Fields of enum types.
$_enum_fields:
    ( ($__item: $attributes name (= $expression)?) (, $__item)* ,? )?
;

# Type.
$type:
    $attributes
    $decorate
    (
        (class | struct | interface) name $generic_params? (\: base:$type_name (, base:$type_name)*)?
            $generic_constraints
        {
            ($method | $field | $property | $event | $type | $_fields | $type_def) * 
        }
    |
        enum name (\: underlying:$type_name (, base:$type_name)*)?
        {
            $_enum_fields
            (\; ($method | $field | $property | $event | $type | $_fields | $type_def) *)?
        }
    ) \;?
;

# Type name units, such as: MyStruct, MyClass<int, long> .
$name_unit: name $generic_args? ;

# General type name.
$general_type_name:
    (
        (global? \:\:)? $name_unit (. $name_unit)*
     |  void | object
     |  char | string | byte | sbyte | short | ushort | int | uint | long | ulong | bool
     |  double | float | decimal
     |  $tuple_args
    ) \??                                      # T? is Nullable<T>
;

# Array type name, such as int[].
$array_type_name: $type_name [ ,* ] \?? ;    # Array, int[]? can be null

# Uncertained type name: var.
$uncertain_type_name: var ;

# Type name.
$type_name: $general_type_name | $array_type_name | $uncertain_type_name ;

# Typedef generic param.
$type_def_param: name ...?;

# Typedef generic params: typedef NewType<T> = MyClass<int, T>; .
$type_def_params: < $type_def_param (, $type_def_param)* > ;

# Typedef: typedef Integer = int; , typedef Func<TRet, TArg> = Delegate<TRet, TArg, TArg>; .
$type_def: $attributes $decorate typedef name $type_def_params? = $type_name \; ;

# Generic param.
$generic_param:  $attributes (in | out)? name ...?;

# Generic params: MyClass<T, K>.
$generic_params: < $generic_param (, $generic_param)* > ;

# Generic constraint: where T : MyClass.
$generic_constraint:
    where name \: ($__item: $type_name | class \?? | struct | new \( \)) (, $__item *)*  ;

# Generic constraints.
$generic_constraints: $generic_constraint * ;

# Generic argument.
$generic_arg: (out | ref | params)? $type_name name?;

# Generic arguments: MyClass<int, long>.
$generic_args: < $generic_arg? (, $generic_arg?) * ...? !:> ;

# The items of a tuple type: (int Number, string Str), (int, string). It is Tuple<..> of the items; the names are kept.
$tuple_args: \( $generic_arg (, $generic_arg)+ \) ;

# Param of methods.
$param:  $attributes (out | ref | in | params | this)? $type_name ...? name (= $expression)? ;

# Params of methods.
$params: $param (, $param)* ;

# Argument of methods calling. The items of a params generic parameter are passed as arguments
# with ...: f(items ...) (many arguments, not one).
$argument:  $attributes (out | ref | in)? (name \:)? ($declaration_exp | $expression ...?) ;

# Arguments of methods calling.
$arguments: $argument (, $argument)* ;

# Argument for new expressions.
$_init_arg: (name =)? $expression | { ($_init_arg (, $_init_arg)* ,?)? } ;

# Arguments for new expressions: new MyClass { Value1 = 1, Value2 = 2 }.
$_init_args: $_init_arg (, $_init_arg) * ,? ; 

# Attribute type name.
$_attribute_type_name : $general_type_name;

# Attribute group: [EntryPoint, Trace].
$_attribute_group:
    [ ($__item: $_attribute_type_name (
	\(
		(($arguments | ($__assign: name = $expression)) (, $__assign)*)?
	\) )?) (, $__item)* ]
;

# Attributes of the assembly: [assembly: Author("ann")]. It is alone, at the root of the code.
$_assembly_group:
    [ assembly \: ($__item: $_attribute_type_name (
	\(
		(($arguments | ($__assign: name = $expression)) (, $__assign)*)?
	\) )?) (, $__item)* ]
;

# Attributes: [Entrypoint, Trace] [Inline]
$attributes: ($attribute | $_attribute_group) * ;

# Method body: a block, or an expression (the body is the return of its value, or the expression
# itself when the method returns nothing): int GetValue() => 10; , get => value; .
$method_body: { $statement* } | => $expression \; | => throw $expression \; ;

# Operators.
$_operator:
    \+  | -   | \*  | /   | %
  | \+= | -=  | \*= | /=  | %=
  | =   | ==  | !=  | `>  | >= | `< | <=
  | <<  | <<= | >>  | >>=
  | &&  | \|\|
  | \|  | ^   | &   | \|= | &= | ^=
  | \+\+ | -- | ! | ~
;

# Method member.
$method:
    $attributes
    $decorate
    ret:$type_name? ~ ? (owner:$type_name .)?
    ( name | (implicit | explicit)? operator checked? ($_operator | conversion:$type_name) )
    $generic_params? \( $params? \) ( \: (base | this) \( $arguments? \) )?
    $generic_constraints
    ($method_body | \;)
;

# Fields.
$_fields:
    $attributes
    $decorate
    $type_name ($__item: $attributes name (= $expression)? ) (, $__item)* \;
;

# Fake method, used in property/event body.
$_fake_method:
    $attributes $decorate (get | set | init | add | remove | raise \( $params? \)) ($method_body | \;)
;

# Property member.
$property:
    $attributes
    $decorate
    ret:$type_name ((owner:$type_name .)? name | this [ $params ])
    ({
        $_fake_method *
    } (= init:$expression \;)? | => $expression \; | => throw $expression \; )
;

# Event member.
$event:
    $attributes
    $decorate event
    ret:$type_name (owner:$type_name .)? name
    ({
        $_fake_method *
    } | \; )
;

# While statement.
$while_st:
    while \( $expressions \)
    $statement
;

# Do ... while statement.
$do_while_st:
    do
        $statement
    while \( $expressions \) \;
;

# For statement.
$for_st:
    for \( ($defination_st | initialize:$expressions \; | \;)?
        condition:$expressions? \; increase:$expressions? \)
    $statement
;

# For ... each statement. await foreach goes through an IAsyncEnumerable<T>: it waits for each item. The item can be
# deconstructed: foreach (var (a, b) in items) .
$for_each_st:
    await? foreach \( ($type_name name | var \( name (, name)+ \)) in $expression \)
    $statement
;

# Using statement: using (IDisposable obj = new DisposableObject()) { ... } , or the using
# declaration: using IDisposable obj = new DisposableObject(); , the object is disposed at the end
# of the block, the statements that follow the declaration are the body. The object does not need
# a variable: using (new DisposableObject()) { ... } , using new DisposableObject(); .
$using_st:
    (
        using
        (
            \( ($type_name name = $expression | $expression) \) $statement
          | ($type_name name = $expression | $expression) \;
        )
      | lock \( $expression \) $statement
    )
;

# If statement.
$if_st:
    if \( $expressions \)
        if_body:$statement
    (else else_body:$statement)?
;

# Statement collection.
$statements: $statement * ;

# Case in switch.
# A label of a case: a constant (case 1:), a declaration of a type pattern (case String s:), and the condition that goes with
# them (case 1 when a > b:, case String s when s.Length > 0:).
# The labels of a case: a label that follows another one is one of them (case 1: case 2: ..), not the start of a case that
# has no statements: its words have a weight.
$case:
    (case ($declaration_exp | $expression) (when when:$expression)? | default) \:
    ((!:case ($declaration_exp | $expression) (when when:$expression)? | !:default) \:)*
        $statements
;

# Switch statement.
$switch_st:
    switch \( $expressions \)
    {
        $case *
    }
;

# Catch in try ... catch ... finally statement.
# A catch can have a filter: catch (Exception e) when (e.Code == 1) { ... } , it is tried when the exception is of the type.
$catch:
    catch ( \( $type_name name? \) )? (when \( when:$expression \))?
        $statement
;

# Try ... catch ... finally statement.
$try_st:
    try
        try:$statement
    $catch *
    (finally
        finally:$statement)?
;

# Variables defination statememt: int a = 10, b = 20;
# A ref local variable is another name of a variable: ref Int32 r = ref x; .
$defination_st:
    (const | ref)? $type_name ($__item: name (= ref? $expression)?) (, $__item)* \;
;

# Deconstruction that declares variables: (int Number, string Str) = tuple; . Each item has a type (var too) and a name.
$deconstruct_st: $tuple_args = $expression \; ;

# Deconstruction that declares variables that are all var: var (Number, Str) = tuple; . A name that is _ is no variable.
$deconstruct_var_st: var \( name (, name)+ \) = $expression \; ;

# Deconstruction that assigns variables: (a, b) = (b, a); .
$deconstruct_assign_st: !:\( name (, name)+ \) = $expression \; ;

# Expression statement: a = b + c;
$expression_st: $expression \; ;

# Typedef statement: typedef Integer = int; .
$type_def_st:   $type_def ;

# Break statement.
$break_st:      break \; ;

# Continue statement.
$continue_st:   continue \; ;

# Throw statement.
$throw_st:      throw $expression? \; ;

# Return statement.
$return_st:     return $expression? \; ;

# Goto statement: goto label; , goto case 1; , goto default; .
$goto_st:       goto (name | case $expression | default) \; ;

# A labeled statement: again: i++; . The statement is where goto label; jumps to.
$label_st:      name \: $statement ;

# Yield statement: yield return x; , yield break; .
$yield_st:      yield (return $expression | break) \; ;

# A empty statement.
$empty_st:      \; ;

# Statement group, checked { ... } and unchecked { ... } too: the arithmetic of the statements
# raises OverflowException when the result does not fit its type, or not.
$statement_group_st: (checked | unchecked)? { $statement * } ;

# Statement.
$statement:
    $do_while_st | $while_st | $for_st | $for_each_st | $using_st
  | $if_st | $switch_st | $try_st | $empty_st
  | $break_st | $continue_st | $throw_st | $return_st | $goto_st | $label_st | $yield_st
  | $deconstruct_assign_st | $deconstruct_var_st | $deconstruct_st | $expression_st | $defination_st | $type_def_st
  | $statement_group_st
;

# Root, entrypoint of code analyzer.
$: $import* ($using | $namespace | $type | $type_def | $_assembly_group)* ;


